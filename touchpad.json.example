{
  "version": 2,
  "default_device": "auto",
  "devices": {
    "Primax Electronics Ltd. ASUS Zenbook Duo Keyboard Touchpad": {
      "logical": "Primax Electronics Ltd. ASUS Zenbook Duo Keyboard Touchpad",
      "enabled": true,
      "transports": {
        "usb": {
          "filters": [
            { "plugin": "event_sim", "enabled": false },
