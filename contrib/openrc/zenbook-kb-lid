#!/sbin/openrc-run
# OpenRC: watch logind LidClosed for keyboard backlight save/restore.
#
# Install via configure.py (elogind systems — acpid does not receive lid events).

name="zenbook-kb-lid"
description="Zenbook Duo keyboard backlight on lid open/close"

: "${command:=/usr/bin/kb-brightness-lid-watch}"
: "${command_background:=yes}"
: "${pidfile:=/run/${RC_SVCNAME}.pid}"
: "${output_log:=/var/log/${RC_SVCNAME}.log}"
: "${error_log:=/var/log/${RC_SVCNAME}.log}"

depend() {
	need localmount
	after elogind dbus
	use logger
}

_zenbook_lid_kill_all() {
	if command -v pkill >/dev/null 2>&1 && [ -n "${command:-}" ]; then
		pkill -TERM -f "${command}" 2>/dev/null || true
		sleep 0.2
		pkill -KILL -f "${command}" 2>/dev/null || true
	fi
	rm -f "${pidfile:-/run/${RC_SVCNAME}.pid}"
}

start_pre() {
	for _wait_lib in \
		/usr/share/zenbook-scripts/lib/openrc-wait.sh \
		/usr/local/share/zenbook-scripts/lib/openrc-wait.sh; do
		if [ -f "${_wait_lib}" ]; then
			# shellcheck source=lib/openrc-wait.sh
			. "${_wait_lib}"
			zenbook_rc_clear_stale_svc_pidfile
			break
		fi
	done
	checkpath -d -m 0755 -o root:root /run
	if [ -n "${output_log:-}" ]; then
		checkpath -f -m 0664 -o root:root "$output_log"
	fi
	if ! busctl status org.freedesktop.login1 >/dev/null 2>&1; then
		eerror "org.freedesktop.login1 not available (install/start elogind)"
		return 1
	fi
	# Bash scripts appear as "bash /usr/bin/...": --exec alone misses orphans.
	_zenbook_lid_kill_all
}

stop_pre() {
	# Save brightness before shutdown/reboot (restored at next service start).
	for _sleep in /usr/bin/kb-brightness-sleep /usr/local/bin/kb-brightness-sleep; do
		if [ -x "${_sleep}" ]; then
			"${_sleep}" save 2>/dev/null || true
			break
		fi
	done
}

stop() {
	ebegin "Stopping ${RC_SVCNAME}"
	_pid=""
	if [ -n "${pidfile:-}" ] && [ -f "${pidfile}" ]; then
		_pid="$(tr -d '[:space:]' < "${pidfile}" 2>/dev/null || true)"
	fi
	if [ -n "${_pid}" ] && kill -0 "${_pid}" 2>/dev/null; then
		default_stop
		_zenbook_lid_kill_all
		eend $?
		return $?
	fi
	_zenbook_lid_kill_all
	eend 0
	return 0
}
