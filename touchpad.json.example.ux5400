{
  "version": 2,
  "default_device": "auto",
  "devices": {
    "GDX1515:00 27C6:01F4 Touchpad|i2c-GDX1515:00": {
      "enabled": true,
      "filters": [
        { "plugin": "event_sim", "enabled": false },
        { "plugin": "typing_inhibit", "window_ms": 350, "enabled": true },
        { "plugin": "exec_delay", "ms": 25, "enabled": true },
        { "plugin": "outlier_reject", "max_delta": 1200, "enabled": true },
        { "plugin": "soft_accel", "gain": 1.6, "mode": "linear", "pivot": 40, "enabled": false }
      ]
    }
  }
}
