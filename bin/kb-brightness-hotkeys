#!/usr/bin/env bash
# Listen for Zenbook Duo Fn+ / special keys and dispatch configured actions.
#
# Usage:
#   kb-brightness-hotkeys              Auto-detect hotkey input devices
#   kb-brightness-hotkeys --list         List watched devices
#   kb-brightness-hotkeys --show-keys    List mappable keys per device
#   kb-brightness-hotkeys --show-profile Full DMI + binding profile
#   kb-brightness-hotkeys --verbose      Extra startup + runtime key logging
#   kb-brightness-hotkeys --debug        --verbose + every evdev key press
#   kb-brightness-hotkeys --dry-run      Log actions without executing
#
# Service log: /var/log/zenbook-kb-hotkeys.log (profile on every start).
# Enable key capture: command_args="--verbose --debug" in /etc/conf.d/zenbook-kb-hotkeys
# or service_verbose=true / service_debug=true in zenbook-hotkeys.conf [options].
#
# Bindings: ~/.config/zenbook-scripts/zenbook-hotkeys.conf
# Unmapped special keys are logged so you can add bindings.

set -euo pipefail

_zenbook_wrapper_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for _root_sh in \
    "${_zenbook_wrapper_dir}/../lib/zenbook_root.sh" \
    /usr/share/zenbook-scripts/lib/zenbook_root.sh \
    /usr/local/share/zenbook-scripts/lib/zenbook_root.sh; do
    if [[ -f "${_root_sh}" ]]; then
        # shellcheck source=lib/zenbook_root.sh
        source "${_root_sh}"
        break
    fi
done
if declare -F zenbook_share_dir >/dev/null 2>&1; then
    SCRIPT_DIR="$(zenbook_share_dir)"
else
    zenbook_kb_find_root() {
        local here
        here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
        if [[ -f "${here}/../zenbook_kb/hotkey.py" ]]; then
            echo "$(cd "${here}/.." && pwd)"
            return 0
        fi
        if [[ -f /usr/share/zenbook-scripts/zenbook_kb/hotkey.py ]]; then
            echo /usr/share/zenbook-scripts
            return 0
        fi
        if [[ -f /usr/local/share/zenbook-scripts/zenbook_kb/hotkey.py ]]; then
            echo /usr/local/share/zenbook-scripts
            return 0
        fi
        echo "zenbook_kb/hotkey.py not found" >&2
        return 1
    }
    SCRIPT_DIR="$(zenbook_kb_find_root)"
fi
unset _zenbook_wrapper_dir _root_sh
export PYTHONPATH="${SCRIPT_DIR}${PYTHONPATH:+:${PYTHONPATH}}"

if [[ -n "${SUDO_USER:-}" ]]; then
    export HOME="$(getent passwd "${SUDO_USER}" | cut -d: -f6)"
fi

exec python3 "${SCRIPT_DIR}/zenbook_kb/hotkey.py" "$@"
