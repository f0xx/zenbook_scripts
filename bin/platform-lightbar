#!/usr/bin/env python3
"""UX581 front lightbar CLI — see zenbook_kb.lightbar / README.ux581.md."""

from __future__ import annotations

import sys
from pathlib import Path

_ROOT = Path(__file__).resolve().parent.parent
for _share in (_ROOT, Path("/usr/share/zenbook-scripts"), Path("/usr/local/share/zenbook-scripts")):
    if (_share / "zenbook_kb" / "lightbar.py").is_file():
        sys.path.insert(0, str(_share))
        break

from zenbook_kb.lightbar import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
