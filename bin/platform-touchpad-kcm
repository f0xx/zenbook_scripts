#!/usr/bin/env python3
"""KCM helper — export/import touchpad knob JSON (mirrors platform-touchpad-gui)."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

_SCRIPT_DIR = Path(__file__).resolve().parent
_REPO_ROOT = _SCRIPT_DIR.parent
if str(_REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(_REPO_ROOT))

from zenbook_kb.touchpad_kcm import export_knobs, import_knobs  # noqa: E402


def main() -> int:
    p = argparse.ArgumentParser()
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("export")
    sp = sub.add_parser("import")
    sp.add_argument("path", nargs="?", default="-")
    args = p.parse_args()
    if args.cmd == "export":
        print(json.dumps(export_knobs(), indent=2))
        return 0
    raw = sys.stdin.read() if args.path == "-" else Path(args.path).read_text(encoding="utf-8")
    path = import_knobs(json.loads(raw))
    print(path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
